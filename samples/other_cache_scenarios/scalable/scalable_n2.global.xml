<?xml version="1.0" encoding="UTF-8"?>
<!-- cpuSpeed: instructions/s, ioRead/ioWrite: operations/s, txSpeed/rxSpeed: MB/s (abstract units) -->
<!-- Scalability run: 20,000 requests, hit ratio 0.9, no affinity, 2 cache nodes. -->
<bsim:globalConfiguration xmlns:bsim="http://bsim.hpi.uni-potsdam.de/scylla/simModel" targetNamespace="http://www.hpi.de" id="distcache-global" softmaxExponent="1">
  <bsim:resourceData>
    <bsim:dynamicResource id="cache" defaultQuantity="2" defaultCost="1" defaultTimeUnit="SECONDS" cpuSpeed="1000" txSpeed="1" />
    <bsim:dynamicResource id="db" defaultQuantity="1" defaultCost="1" defaultTimeUnit="SECONDS" ioRead="1" />
    <bsim:dynamicResource id="app" defaultQuantity="20" defaultCost="1" defaultTimeUnit="SECONDS" cpuSpeed="1000" />
  </bsim:resourceData>
  <bsim:randomSeed>42</bsim:randomSeed>
</bsim:globalConfiguration>
