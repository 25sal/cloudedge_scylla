<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProxyCache" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="proxycache" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Request arrives">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Proxy_Lookup" name="Proxy lookup">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Hit" name="Cache hit?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Hit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Miss</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Proxy_Serve_Hit" name="Proxy serve hit">
      <bpmn:incoming>Flow_Hit</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Hit" name="Served from cache">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Origin_Fetch" name="Origin fetch">
      <bpmn:incoming>Flow_Miss</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Proxy_Store" name="Proxy store">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Miss" name="Served from origin">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Proxy_Lookup" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Proxy_Lookup" targetRef="Gateway_Hit" />
    <bpmn:sequenceFlow id="Flow_Hit" name="hit" sourceRef="Gateway_Hit" targetRef="Proxy_Serve_Hit" />
    <bpmn:sequenceFlow id="Flow_Miss" name="miss" sourceRef="Gateway_Hit" targetRef="Origin_Fetch" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Proxy_Serve_Hit" targetRef="EndEvent_Hit" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Origin_Fetch" targetRef="Proxy_Store" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Proxy_Store" targetRef="EndEvent_Miss" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="proxycache">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Proxy_Lookup_di" bpmnElement="Proxy_Lookup">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Hit_di" bpmnElement="Gateway_Hit" isMarkerVisible="true">
        <dc:Bounds x="400" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Proxy_Serve_Hit_di" bpmnElement="Proxy_Serve_Hit">
        <dc:Bounds x="520" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Hit_di" bpmnElement="EndEvent_Hit">
        <dc:Bounds x="700" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Origin_Fetch_di" bpmnElement="Origin_Fetch">
        <dc:Bounds x="520" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Proxy_Store_di" bpmnElement="Proxy_Store">
        <dc:Bounds x="680" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Miss_di" bpmnElement="EndEvent_Miss">
        <dc:Bounds x="860" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="400" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Hit_di" bpmnElement="Flow_Hit">
        <di:waypoint x="425" y="175" />
        <di:waypoint x="425" y="80" />
        <di:waypoint x="520" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Miss_di" bpmnElement="Flow_Miss">
        <di:waypoint x="425" y="225" />
        <di:waypoint x="425" y="320" />
        <di:waypoint x="520" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="620" y="80" />
        <di:waypoint x="700" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="620" y="320" />
        <di:waypoint x="680" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="780" y="320" />
        <di:waypoint x="860" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
